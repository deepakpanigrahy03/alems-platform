{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alems/raf/laya_p_io/1.1.0",
  "title": "laya_p request and response for POST /v1/systemone (R6 client, R7 server)",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "template_version", "items"],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "template_version": {"const": "v3", "description": "laya_text template the texts were rendered with"},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["option", "text"],
            "properties": {
              "option": {"pattern": "^(FR|SR|RB|SG)_(warm|cold)$"},
              "text": {"type": "string", "description": "laya_text v3 output for this option"}
            }
          }
        }
      }
    },
    "response": {
      "type": "object", "additionalProperties": true,
      "required": ["template_version", "model_version", "calibration", "p"],
      "properties": {
        "template_version": {"type": "string", "description": "template the serving checkpoint was trained on; must equal the request's"},
        "model_version": {"type": "string"},
        "calibration": {"type": "string"},
        "p": {
          "type": "object",
          "propertyNames": {"pattern": "^(FR|SR|RB|SG)_(warm|cold)$"},
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "latency_ms": {"type": "number", "minimum": 0}
      }
    }
  },
  "description": "Client rule: timeout 2 s; any timeout, connection error, non 200, template mismatch, missing calibration or missing option fails closed to beta_p with the reason recorded."
}
